msgstr "https://www.robotstxt.software/plugins/noindex-seo/"

#. Description of the plugin
#: noindex-seo.php
msgid ""
"Control search engine indexing with robots directives (noindex, nofollow, "
"noarchive, nosnippet, noimageindex) for specific parts of your WordPress "
"site."
msgstr ""
"Controla la indexación en buscadores con directivas robots (noindex, "
"nofollow, noarchive, nosnippet, noimageindex) para partes específicas de tu "
"sitio WordPress."

