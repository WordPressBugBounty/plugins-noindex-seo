msgid "noindex SEO"
msgstr "noindex SEO"

#. Plugin URI of the plugin
#: noindex-seo.php
msgid "https://www.robotstxt.software/plugins/noindex-seo/"
msgstr "https://www.robotstxt.software/plugins/noindex-seo/"

#. Description of the plugin
#: noindex-seo.php
msgid ""
"Control search engine indexing with robots directives (noindex, nofollow, "
"noarchive, nosnippet, noimageindex) for specific parts of your WordPress "
"site."
msgstr ""
"Controla la indexació als cercadors amb directrius robots (noindex, "
"nofollow, noarchive, nosnippet, noimageindex) per a parts específiques del "
"vostre lloc WordPress."

